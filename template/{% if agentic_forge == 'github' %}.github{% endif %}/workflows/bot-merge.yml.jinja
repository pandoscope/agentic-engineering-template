# The merge bot (agentic-engineering-template#260, ruled on
# pandoscope/meta#132).
#
# GitHub Free enforces no rulesets on private repos: ci-ok is advisory
# there and the merge button works on red. Repository permissions are
# the control the plan still honours, so on a private repo that needs
# branch protection humans hold no write to main and THIS job, acting
# as the release bot, is the one path in. It fires when the CI gate
# completes or a review lands, re-judges the head with the aggregate's
# own verdict (every job of every PR workflow succeeded, `merge
# approval` included) and merges with a merge commit. It never
# fabricates green: a PR the gate rejects stays open, a draft is never
# merged, and a public repo or an unset BOT_MERGE_ENABLED makes it say
# so in one line and do nothing. session-memory does not render it.
name: Merge bot

on:
  workflow_run:
    workflows: ["CI gate"]
    types: [completed]
  pull_request_review:
    types: [submitted]

# The merge goes through the release-bot token minted below, so it is
# attributed to the bot and CI on main runs. The default token reads.
permissions:
  contents: read
  actions: read
  pull-requests: read

concurrency:
  group: bot-merge-{% raw %}${{ github.event.workflow_run.head_sha || github.event.pull_request.head.sha }}{% endraw %}
  cancel-in-progress: false

jobs:
  merge:
    name: "merge when green"
    runs-on: {{ agentic_actions_runner }}
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6

      - name: Mint release-bot installation token
        id: app-token
        uses: actions/create-github-app-token@fee1f7d63c2ff003460e3d139729b119787bc349 # v2.2.2
        with:
          app-id: {% raw %}${{ vars.RELEASE_BOT_CLIENT_ID }}{% endraw %}
          private-key: {% raw %}${{ secrets.RELEASE_BOT_PRIVATE_KEY }}{% endraw %}

      - name: Merge the PR at this head once every PR workflow is green
        env:
          GH_TOKEN: {% raw %}${{ steps.app-token.outputs.token }}{% endraw %}
          HEAD_SHA: {% raw %}${{ github.event.workflow_run.head_sha || github.event.pull_request.head.sha }}{% endraw %}
          REPO_PRIVATE: {% raw %}${{ github.event.repository.private }}{% endraw %}
          BOT_MERGE_ENABLED: {% raw %}${{ vars.BOT_MERGE_ENABLED }}{% endraw %}
        run: python3 scripts/ci/check_gate.py merge
