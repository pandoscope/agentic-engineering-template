name: Order check

# Every order on a pull request is validated against the order schema.
# An order off the schema turns the order's pull request red, so the placing session sees the fault.
# The check does not hold the Routine back: the Routine starts its session when the pull request opens.
on:
  pull_request:
    paths: ["orders/*.yml"]
  push:
    branches: [main]
    paths: ["orders/*.yml"]

permissions:
  contents: read

concurrency:
  group: order-check-{% raw %}${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  order-check:
    name: orders validate against the schema
    runs-on: {{ agentic_actions_runner }}
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6
      - uses: astral-sh/setup-uv@fac544c07dec837d0ccb6301d7b5580bf5edae39 # v8.2.0
      - name: pandoscope order check
        run: |
          set -eu
          shopt -s nullglob
          files=(orders/*.yml)
          if [ "{% raw %}${#files[@]}{% endraw %}" -eq 0 ]; then echo "no orders"; exit 0; fi
          uvx pandoscope==0.3.0 order check "${files[@]}"
